# ==============================================================================
# POVERTYWATCH PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.production on your production server.
# ==============================================================================

# Application Environment
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://povertywatch.id

# Database Configuration (PostgreSQL in Docker Compose)
POSTGRES_USER=povertywatch
POSTGRES_PASSWORD=GENERATE_A_VERY_STRONG_PASSWORD_HERE
POSTGRES_DB=povertywatch
DATABASE_URL=postgresql://povertywatch:GENERATE_A_VERY_STRONG_PASSWORD_HERE@db:5432/povertywatch

# Security Secret (Minimum 32 random characters for session signing)
ADMIN_SESSION_SECRET=GENERATE_64_CHAR_RANDOM_SECRET_HEX_HERE

# Scraper Configuration
SCRAPER_USER_AGENT=PovertyWatch-Bot/1.0 (+https://povertywatch.id/about-bot)
SCRAPER_CRON_SCHEDULE="0 6 * * *"
SCRAPER_CONCURRENCY=3

# Optional AI Configuration (Defaults to offline/deterministic rule-based if unset)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

